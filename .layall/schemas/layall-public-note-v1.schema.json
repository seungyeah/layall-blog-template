{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layall.app/schemas/layall-public-note-v1.schema.json",
  "title": "LayAll public note v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "layall-public-note"
    },
    "version": {
      "const": 1
    },
    "appId": {
      "const": "com.seungyeah.layall"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "permalink": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "coverAttachmentId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "permalink",
        "locale",
        "publishedAt",
        "updatedAt",
        "authors"
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "authorSummary": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "priority": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dueDate": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "status"
            ]
          }
        },
        "memos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "targetType": {
                "type": "string"
              },
              "targetId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "body",
              "targetType",
              "targetId"
            ]
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "sortOrder": {
                "type": "integer"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "type": "string"
                    },
                    "priority": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "dueDate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "status"
                  ]
                }
              },
              "memos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "targetType": {
                      "type": "string"
                    },
                    "targetId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "body",
                    "targetType",
                    "targetId"
                  ]
                }
              },
              "highlights": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "color": {
                      "type": "string"
                    },
                    "memo": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "targetType": {
                      "type": "string"
                    },
                    "targetId": {
                      "type": "string"
                    },
                    "selectedText": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "color",
                    "targetType",
                    "targetId"
                  ]
                }
              }
            },
            "required": [
              "id",
              "title",
              "content",
              "sortOrder"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "pages"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relativePath": {
            "type": "string"
          },
          "alt": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "mimeType",
          "byteSize",
          "sha256",
          "relativePath"
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "appId",
    "publication",
    "note",
    "attachments"
  ]
}
